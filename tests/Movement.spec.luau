local Movement = require("../src/Movement")
local passed = 0
local function test(name, body)
    body()
    passed += 1
    print("PASS " .. name)
end
test("steering uses normalized horizontal world input", function()
    local x, z, state = Movement.steer(300, 40, -400, 0, 0, 1/60)
    assert(math.abs(x - 0.6) < 0.0001 and math.abs(z + 0.8) < 0.0001 and state == "moving")
end)
test("arrival uses a three-dimensional stop radius with margin", function()
    local x, z, state = Movement.steer(20, 20, 20, 1000, 0, 1/60)
    assert(x == 0 and z == 0 and state == "holding")
    local _, _, vertical = Movement.steer(0, 60, 0, 0, 0, 1/60)
    assert(vertical == "vertical")
end)
test("fast approach brakes before passing the destination", function()
    local x, z, state = Movement.steer(100, 0, 0, 5000, 0, 1/60)
    assert(x == 0 and z == 0 and state == "braking")
    local resumed, _, after = Movement.steer(100, 0, 0, 0, 0, 1/60)
    assert(resumed == 1 and after == "moving")
end)
test("board travel uses its smaller stopping radius", function()
    local x, _, state = Movement.steer(20, 0, 0, 0, 0, 1/60, 6)
    assert(x == 1 and state == "moving")
    local _, _, reached = Movement.steer(5, 0, 0, 200, 0, 1/60, 6)
    assert(reached == "holding")
end)
test("non-finite movement samples cannot generate input", function()
    for _, value in ipairs({ math.huge, -math.huge, 0/0 }) do
        assert(not pcall(Movement.steer, value, 0, 0, 0, 0, 1/60))
        assert(not pcall(Movement.steer, 100, 0, 0, value, 0, 1/60))
    end
end)
print(string.format("%d movement tests passed", passed))
